# ─────────────────────────────────────────────────────────────────────────────
# Snackora – environment variables
# Copy to .env.local for local development. In Vercel, set them under
# Project → Settings → Environment Variables. Never commit real values.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays server-side.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site URL (no trailing slash). Used for canonical links, sitemap,
# Open Graph and e-mail links. Production: https://snackora.de
NEXT_PUBLIC_SITE_URL=https://snackora.de

# ── E-mail delivery (Resend) ─────────────────────────────────────────────────
# All three are required for the forms to deliver. If any is missing, the
# forms answer honestly with "vorübergehend nicht verfügbar" (HTTP 503).
#
# API key from https://resend.com/api-keys ("Sending access" is enough)
RESEND_API_KEY=
# Business inbox(es) receiving inquiries; comma-separated for several
CONTACT_EMAIL=kontakt@snackora.de
# Sender on a domain verified in Resend – never the visitor's address
EMAIL_FROM=Snackora Website <website@snackora.de>

# Optional: confirmation e-mail to the visitor ("true" / "false", default false)
AUTO_REPLY_ENABLED=false
# Optional: Reply-To of that confirmation (defaults to the first CONTACT_EMAIL)
EMAIL_REPLY_TO=

# ── Distributed rate limiting (Upstash Redis, recommended for production) ────
# Without these, a per-instance in-memory limiter is used (development only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: secret salt for pseudonymising IP addresses in rate-limit keys
RATE_LIMIT_SALT=

# ── Alternative to Resend: SMTP (e.g. Zoho Mail, paid plans only) ────────────
# Used only when RESEND_API_KEY is empty. For Zoho Mail (EU, custom domain):
#   SMTP_HOST=smtppro.zoho.eu  SMTP_PORT=465  SMTP_USER=kontakt@snackora.de
#   SMTP_PASSWORD=<Zoho app-specific password>
# EMAIL_FROM must then be the SMTP mailbox or one of its aliases, e.g.
#   EMAIL_FROM=Snackora Website <kontakt@snackora.de>
# Also set emailDelivery: "smtp" in src/config/business.ts (privacy policy).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
