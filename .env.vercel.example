# ─────────────────────────────────────────────────────────────────────────────
# Template for the Vercel environment variables of snackora.de.
#
#   cp .env.vercel.example .env.vercel.local   # fill in values (never committed)
#   npm run env:push                            # → Vercel Production
#   npm run env:push -- --preview --redeploy    # also Preview, then redeploy
#
# Empty values are skipped (existing Vercel values stay untouched).
# Variables marked [secret] are stored as "Sensitive" in Vercel (write-only).
# Full documentation of each variable: .env.example
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=https://snackora.de

# Google Analytics 4 measurement ID (G-…). Production only – do not push with --preview.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# [secret] /admin dashboard login (Production only). Use a long, unique password.
ADMIN_PASSWORD=
# [secret] signs the admin session cookie – e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# [secret] Resend → API Keys → "Sending access"
RESEND_API_KEY=
EMAIL_FROM=Snackora <info@snackora.de>
AUTO_REPLY_ENABLED=false
# Optional Reply-To of the visitor confirmation (empty = the form's inbox)
EMAIL_REPLY_TO=

# Upstash Redis (Frankfurt) – REST URL and [secret] token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# [secret] any long random string, e.g. `openssl rand -hex 32`
RATE_LIMIT_SALT=

# TEST ONLY: if set, every form goes to this address. Keep empty in production.
CONTACT_EMAIL=
